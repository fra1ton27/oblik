# --- База данных ---------------------------------------------------------
# Docker:          docker compose up -d   → postgres://oblik:oblik@localhost:5432/oblik
# Без Docker:      pnpm db:dev            → тот же адрес (встроенный PostgreSQL из npm)
DATABASE_URL=postgres://oblik:oblik@127.0.0.1:5432/oblik

# --- Payload ---------------------------------------------------------------
# Случайная строка ≥ 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Публичный адрес сайта без слеша на конце
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 — закрыть весь сайт от индексации (стенд на production-сборке); dev закрыт всегда
ROBOTS_DISALLOW_ALL=

# --- Почта ---------------------------------------------------------------------
# Без RESEND_API_KEY и SMTP_HOST письма пишутся в консоль сервера
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Oblik <hello@oblik.example>
MANAGER_EMAIL=manager@oblik.example

# --- Seed ----------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@oblik.example
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_CUSTOMER_EMAIL=demo@oblik.example
SEED_CUSTOMER_PASSWORD=change-me-demo-password

# --- Антиспам (необязательно) ---------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Хранилище медиа в prod (необязательно, S3-совместимое) ---------------------
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Аналитика (необязательно, грузится только после согласия на cookie) ----
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=
